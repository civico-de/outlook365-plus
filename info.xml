<?xml version="1.0"?>
<extension key="outlook365" type="module">
  <file>outlook365</file>
  <name>Outlook 365 Integration</name>
  <description>This extension integrates CiviCRM with Microsoft Outlook 365.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>civico GmbH (fork); Jaap Jansma, CiviCoop (original author)</author>
    <email>hi@jfilter.de</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/civico-de/outlook365</url>
    <url desc="Documentation">https://github.com/civico-de/outlook365/blob/main/README.md</url>
    <url desc="Upstream">https://lab.civicrm.org/extensions/outlook365</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-22</releaseDate>
  <version>3.1.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.17</ver>
  </compatibility>
  <comments>Funded by MAKOA. Developed and supported by CiviCoop and Agileware. Forked by civico GmbH: the credential travels in the X-Civi-Auth header.</comments>
  <civix>
    <namespace>CRM/Outlook365</namespace>
    <format>25.10.2</format>
  </civix>
  <requires>
    <ext>dataprocessor</ext>
    <ext>keyring</ext>
  </requires>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\Outlook365\AutomaticUpgrader</upgrader>
</extension>
